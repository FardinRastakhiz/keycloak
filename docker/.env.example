# Copy to docker/.env and adjust. docker/.env is git-ignored; never commit real secrets.
# Everything except the client secrets has a default in docker-compose.yml.

# Client secrets for the identity-service realm (required). Generate with:
#   openssl rand -hex 24
KC_ADMIN_CLIENT_SECRET=
KC_CLIENT_SECRET=

KEYCLOAK_VERSION=26.7.3
# Build-time features (comma-separated). scim-api is needed for /scim/v2 in the realm.
KC_FEATURES=scim-api

# Postgres
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=keycloak

# Bootstrap admin for the master realm (created on first start only)
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin

# Networking
KC_HTTP_PORT=8080
KC_MGMT_PORT=9000
# Set when running behind a reverse proxy with a fixed public URL, e.g. https://auth.example.com
# KC_HOSTNAME=https://auth.example.com   (add to the keycloak service environment in a compose override)
KC_PROXY_HEADERS=xforwarded

KC_LOG_LEVEL=info
